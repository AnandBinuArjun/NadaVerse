# NadaVerse Environment Configuration Baseline
# Copy this file to .env.local (web) or .env (backend) and adjust values as needed.
# DO NOT COMMIT SECRETS OR REAL USER DATA TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# Web Application (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="NadaVerse"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# -----------------------------------------------------------------------------
# Backend API (FastAPI)
# -----------------------------------------------------------------------------
APP_ENV="development" # Set to "production" in production environments
DEBUG=true            # Set to false in production (enforced at startup)
PORT=8000
HOST="0.0.0.0"

# CORS Origins (Comma-separated origins. Wildcards '*' are rejected in production)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://nadaverse.abarjun.online"

# Security & Session Tokens
# In production, SECRET_KEY MUST be at least 32 bytes (generate with: openssl rand -hex 32)
SECRET_KEY="nadaverse_dev_secret_key_change_in_production_32bytes_min"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Development: SQLite (auto DDL created if DB missing)
# Production: PostgreSQL (migrations must be run via: alembic upgrade head)
DATABASE_URL="sqlite+aiosqlite:///./nadaverse.db"
# Production example:
# DATABASE_URL="postgresql+asyncpg://nadaverse_user:secure_password@localhost:5432/nadaverse_db"

# Redis (Sliding-window rate limiting & distributed state)
# If REDIS_URL is omitted or unreachable, system automatically fails over to in-memory rate limiting
REDIS_URL="redis://localhost:6379/0"

# Rate Limiting & Proxy Security
# Comma-separated list of immediate reverse proxy IPs that are trusted to forward client IPs via X-Forwarded-For
TRUSTED_PROXIES="127.0.0.1,::1"
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=30

# AI Gateway (Provider-neutral interface grounded in verified Carnatic corpus)
AI_GATEWAY_PROVIDER="gemini" # options: "gemini", "mock"
GEMINI_API_KEY=""           # Google Gemini API key for live grounding

# Object Storage (Private audio practice recordings with signed URLs)
STORAGE_PROVIDER="local"     # options: "local", "s3"
STORAGE_BUCKET="nadaverse-recordings"
