# NadaVerse Environment Configuration Baseline
# Copy this file to .env.local (web) or .env (backend) and adjust values as needed.
# DO NOT COMMIT SECRETS OR REAL USER DATA TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# Web Application (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="NadaVerse"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# -----------------------------------------------------------------------------
# Backend API (FastAPI)
# -----------------------------------------------------------------------------
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL - future production target)
DATABASE_URL="postgresql+asyncpg://nadaverse_user:local_dev_only@localhost:5432/nadaverse_db"

# Redis (Caching & Task Coordination)
REDIS_URL="redis://localhost:6379/0"

# AI Gateway (Provider-neutral interface; model is stubbed/mockable in dev)
AI_GATEWAY_PROVIDER="mock" # options: "mock", "gemini", "openai"
AI_GATEWAY_API_KEY=""

# Object Storage (Private media with signed URLs)
STORAGE_PROVIDER="local" # options: "local", "s3"
STORAGE_BUCKET="nadaverse-recordings"
