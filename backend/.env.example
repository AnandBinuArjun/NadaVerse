# Backend API Environment Configuration
APP_ENV="development" # Set to "production" in production
DEBUG=true            # Set to false in production (enforced at startup)
PORT=8000
HOST="0.0.0.0"

# CORS Origins (Strict whitelist in production; no wildcards)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://nadaverse.abarjun.online"

# Security & Session Tokens (Must be >= 32 bytes in production: openssl rand -hex 32)
SECRET_KEY="nadaverse_dev_secret_key_change_in_production_32bytes_min"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Development: SQLite (auto DDL created if DB missing)
# Production: PostgreSQL (migrations must be run via: alembic upgrade head)
DATABASE_URL="sqlite+aiosqlite:///./nadaverse.db"

# Redis & Rate Limiting
REDIS_URL="redis://localhost:6379/0"
TRUSTED_PROXIES="127.0.0.1,::1"
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=30

# AI Gateway
AI_GATEWAY_PROVIDER="gemini"
GEMINI_API_KEY=""
